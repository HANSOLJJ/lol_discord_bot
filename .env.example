DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
# DEV_MODE=true면 이 토큰(롤랜덤챔프봇-dev 앱)으로 로그인한다. 없으면 운영 토큰으로 대체하지 않고 종료한다.
DISCORD_TOKEN_DEV=YOUR_DEV_BOT_TOKEN_HERE
DEV_MODE=false

# (예정) 디스코드 액티비티 인증용 OAuth2 값. 앱마다 다르며 DEV_MODE 규칙은 봇 토큰과 같다.
# 시크릿은 봇 서버만 읽는다. 프론트 .env에는 client ID만 VITE_DISCORD_CLIENT_ID로 넣는다.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_CLIENT_ID_DEV=
# DISCORD_CLIENT_SECRET_DEV=

# (선택) GitHub Pages 자동 배포 - 미설정 시 로컬 기록만
# ARENA_GH_TOKEN: fine-grained PAT, 대상 리포 Contents = Read and write
ARENA_GH_TOKEN=github_pat_xxx
ARENA_GH_REPO=HANSOLJJ/lol_arena
# ARENA_GH_BRANCH=main            # 기본 main
# ARENA_GH_PATH=history_data.json   # 리포 내 데이터 파일 경로(기본값)
